{
    "name": "ezitrans-cms",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "generate": "tsx scripts/generate-registry.ts",
        "predev": "npm run generate",
        "dev": "next dev -p 3006",
        "prebuild": "npm run generate",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "db:seed-header": "npx tsx scratch/seed-header-template.ts",
        "validate:extensions": "tsx scripts/validate-extensions.ts",
        "validate:plugins": "tsx scripts/validate-extensions.ts --plugins",
        "validate:themes": "tsx scripts/validate-extensions.ts --themes",
        "release:validate": "npx prisma generate && npm run validate:themes && npm run validate:plugins && npx tsc --noEmit && npx prisma validate",
        "migrate:deploy": "prisma migrate deploy",
        "update:preflight": "tsx scripts/update-preflight.ts"
    },
    "dependencies": {
        "@craftjs/core": "^0.2.12",
        "@craftjs/layers": "^0.2.7",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@types/diff": "^7.0.2",
        "@types/nodemailer": "^8.0.0",
        "@types/sax": "^1.2.7",
        "bcryptjs": "^3.0.3",
        "diff": "^9.0.0",
        "fast-xml-parser": "^5.10.1",
        "lucide": "^1.17.0",
        "lucide-react": "^1.16.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "nodemailer": "^8.0.9",
        "pg": "^8.21.0",
        "qrcode": "^1.5.4",
        "react": "19.2.4",
        "react-colorful": "^5.7.0",
        "react-dom": "19.2.4",
        "react-quill-new": "^3.8.3",
        "saxes": "^6.0.0",
        "sharp": "^0.34.5",
        "speakeasy": "^2.0.0",
        "styled-components": "^6.4.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/speakeasy": "^2.0.10",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "prisma": "^7.8.0",
        "tailwindcss": "^4",
        "tsx": "^4.22.4",
        "typescript": "^5"
    }
}
